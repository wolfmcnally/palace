    "DataRetentionMode": {
      "type": "string",
      "documentation": "<p>The data retention mode for the account. Valid values are:</p> <ul> <li> <p> <code>default</code> \u2013 The standard data handling for the model applies.</p> </li> <li> <p> <code>none</code> \u2013 Zero data retention.</p> </li> <li> <p> <code>aws_review</code> \u2013 Amazon Web Services may review the request data. The data is not shared with the model provider. A model must support this mode to be invoked under it.</p> </li> <li> <p> <code>provider_data_share</code> \u2013 Data may be shared with the model provider.</p> </li> <li> <p> <code>inherit</code> \u2013 No data retention mode is set at this scope.</p> </li> </ul>",
      "enum": [
        "default",
        "none",
        "aws_review",
        "provider_data_share",
        "inherit"
      ]
    },
