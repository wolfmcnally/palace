#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Durable, candidate-bound receipts for the full gate and the native release lane.

``all`` receipts bind the ordinary full gate; ``native`` receipts bind the
macOS native watcher lane and the host that ran it. ``release-verify``
checks both for the clean current candidate before a release tag.
"""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import json
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

SCHEMA = "agentic_starter.check_all_receipt.v1"
RUN_SCHEMA = "agentic_starter.check_all_run.v1"
NATIVE_SCHEMA = "agentic_starter.check_native_receipt.v1"
NATIVE_RUN_SCHEMA = "agentic_starter.check_native_run.v1"
MACHINE_ID_PATHS = (Path("/etc/machine-id"), Path("/var/lib/dbus/machine-id"))


@dataclass(frozen=True)
class Gate:
    name: str
    state_dir: str
    schema: str
    run_schema: str
    command: str
    pass_line: str


GATES = {
    "all": Gate("all", "check-all", SCHEMA, RUN_SCHEMA, "./bin/check all", "CHECK ALL PASS"),
    "native": Gate(
        "native",
        "check-native",
        NATIVE_SCHEMA,
        NATIVE_RUN_SCHEMA,
        "./bin/check native",
        "CHECK NATIVE PASS",
    ),
}
RECEIPT_FIELDS = frozenset(
    {
        "schema",
        "candidate_id",
        "command",
        "completed_at",
        "environment",
        "environment_fingerprint",
        "log",
        "log_sha256",
        "run",
    }
)
RUN_FIELDS = frozenset(
    {
        "schema",
        "status",
        "candidate_before",
        "candidate_after",
        "environment",
        "environment_fingerprint",
        "host_sha256",
        "log",
        "log_sha256",
        "started_at",
        "completed_at",
        "exit_code",
    }
)
RUNTIME_DESCRIPTOR_FIELDS = frozenset(
    {
        "base_executable",
        "base_executable_sha256",
        "executable",
        "executable_sha256",
        "implementation",
        "machine",
        "platform",
        "python",
        "uv",
    }
)
RUNTIME_DESCRIPTOR_PROGRAM = """
import hashlib
import json
import platform
import subprocess
import sys
from pathlib import Path


def executable_identity(raw_path):
    path = Path(raw_path).resolve(strict=True)
    if not path.is_file():
        raise RuntimeError(f"selected runtime executable is not a file: {path}")
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return str(path), digest.hexdigest()


executable, executable_sha256 = executable_identity(sys.executable)
base_executable, base_executable_sha256 = executable_identity(
    getattr(sys, "_base_executable", sys.executable)
)
uv_process = subprocess.run(
    ["uv", "--version"], capture_output=True, text=True, check=False
)
if uv_process.returncode != 0:
    detail = uv_process.stderr.strip() or uv_process.stdout.strip() or "uv query failed"
    raise RuntimeError(detail)
uv_version = uv_process.stdout.strip()
if not uv_version:
    raise RuntimeError("uv emitted an empty version descriptor")
print(
    json.dumps(
        {
            "base_executable": base_executable,
            "base_executable_sha256": base_executable_sha256,
            "executable": executable,
            "executable_sha256": executable_sha256,
            "implementation": platform.python_implementation(),
            "machine": platform.machine(),
            "platform": platform.platform(),
            "python": platform.python_version(),
            "uv": uv_version,
        },
        sort_keys=True,
        separators=(",", ":"),
    )
)
""".strip()


class ReceiptError(ValueError):
    """A receipt cannot be created or trusted."""


class HostIdentityError(ReceiptError):
    """This host's identity source is present but unreadable."""


def repository_root(start: Path) -> Path:
    process = subprocess.run(
        ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    if process.returncode != 0:
        detail = process.stderr.strip() or "not a Git repository"
        raise ReceiptError(detail)
    return Path(process.stdout.strip()).resolve()


def run_command(root: Path, *arguments: str) -> str:
    process = subprocess.run(
        [*arguments],
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    if process.returncode != 0:
        detail = process.stderr.strip() or process.stdout.strip() or "command failed"
        raise ReceiptError(detail)
    return process.stdout.strip()


def candidate_id(root: Path) -> str:
    value = run_command(root, str(root / "bin" / "kickoff-tree-id"), "--root", str(root))
    validate_digest(value, "candidate id")
    return value


def utc_now() -> str:
    return datetime.now(UTC).isoformat().replace("+00:00", "Z")


def selected_runtime_descriptor(root: Path) -> dict[str, str]:
    raw = run_command(root, str(root / "bin" / "python"), "-c", RUNTIME_DESCRIPTOR_PROGRAM)
    try:
        descriptor = json.loads(raw)
    except ValueError as exc:
        raise ReceiptError(f"selected runtime emitted invalid descriptor JSON: {exc}") from exc
    if not isinstance(descriptor, dict) or set(descriptor) != RUNTIME_DESCRIPTOR_FIELDS:
        raise ReceiptError("selected runtime emitted an invalid descriptor schema")
    if any(not isinstance(value, str) or not value for value in descriptor.values()):
        raise ReceiptError("selected runtime descriptor values must be non-empty strings")
    validate_digest(descriptor["executable_sha256"], "selected executable digest")
    validate_digest(descriptor["base_executable_sha256"], "selected base executable digest")
    return descriptor


def environment_descriptor(
    root: Path, gate: str = "all", host: str | None = None
) -> dict[str, str]:
    """The selected runtime, plus the host digest for the native gate."""
    descriptor = selected_runtime_descriptor(root)
    if gate == "native":
        if host is None:
            raise ReceiptError("gate=native: a native environment needs a host identity")
        descriptor["host_sha256"] = host
    return descriptor


def environment_fingerprint(
    root: Path, gate: str = "all", host: str | None = None
) -> tuple[str, dict[str, str]]:
    descriptor = environment_descriptor(root, gate, host)
    encoded = json.dumps(descriptor, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest(), descriptor


def host_sha256() -> str | None:
    """Return the SHA-256 of this host's stable machine identifier, or None.

    The macOS identifier is the IOPlatformUUID that ``ioreg`` reports; other
    hosts use the machine-id file when one exists. The raw identifier is
    never stored or printed. A present ``ioreg`` that fails raises
    :class:`HostIdentityError`; there is no fallback past it.
    """
    ioreg = shutil.which("ioreg")
    if ioreg is not None:
        process = subprocess.run(
            [ioreg, "-rd1", "-c", "IOPlatformExpertDevice"],
            capture_output=True,
            text=True,
            check=False,
        )
        if process.returncode != 0:
            raise HostIdentityError(
                f"cannot read the host identity (ioreg exit={process.returncode})"
            )
        for line in process.stdout.splitlines():
            if '"IOPlatformUUID"' in line and "=" in line:
                value = line.split("=", 1)[1].strip().strip('"')
                if value:
                    return hashlib.sha256(value.encode()).hexdigest()
        raise HostIdentityError("cannot read the host identity (ioreg reported no IOPlatformUUID)")
    for candidate_path in MACHINE_ID_PATHS:
        try:
            value = candidate_path.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if value:
            return hashlib.sha256(value.encode()).hexdigest()
    return None


def gate_host(gate: str, candidate: str) -> str | None:
    """The host digest a gate run records.

    The native gate refuses without a readable identity. The ordinary gate
    records null instead, which release verification refuses, so a host
    identity fault never blocks ordinary delivery.
    """
    try:
        host = host_sha256()
    except HostIdentityError as exc:
        if gate == "native":
            raise ReceiptError(f"gate=native candidate={candidate}: {exc}") from exc
        print(
            f"check-receipt: gate={gate} candidate={candidate}: {exc};"
            " recording a null host, which release verification refuses",
            file=sys.stderr,
        )
        return None
    if gate == "native" and host is None:
        raise ReceiptError(
            f"gate=native candidate={candidate}: a native receipt needs a host identity"
        )
    return host


def state_root(root: Path, gate: str = "all") -> Path:
    return root / ".kickoff" / GATES[gate].state_dir


def relative_to_root(path: Path, root: Path) -> str:
    try:
        return path.resolve().relative_to(root).as_posix()
    except ValueError as exc:
        raise ReceiptError(f"path escapes repository: {path}") from exc


def atomic_json(path: Path, document: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(document, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)
        raise


def validate_digest(value: str, label: str) -> None:
    if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
        raise ReceiptError(f"invalid {label}: {value!r}")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def receipt_path(root: Path, candidate: str, fingerprint: str, gate: str = "all") -> Path:
    validate_digest(candidate, "candidate id")
    validate_digest(fingerprint, "environment fingerprint")
    return state_root(root, gate) / "receipts" / f"{candidate}-{fingerprint}.json"


def safe_log_path(root: Path, raw: str, gate: str = "all") -> Path:
    path = Path(raw)
    if not path.is_absolute():
        path = root / path
    logs = (state_root(root, gate) / "logs").resolve()
    resolved = path.resolve()
    if not resolved.is_relative_to(logs):
        raise ReceiptError(f"log is outside {logs}: {path}")
    if path.is_symlink():
        raise ReceiptError(f"log must not be a symlink: {path}")
    return resolved


def run_metadata_path(log: Path) -> Path:
    return log.with_suffix(".json")


def load_json(path: Path, label: str) -> dict[str, Any]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise ReceiptError(f"cannot read {label}: {path}: {exc}") from exc
    if not isinstance(document, dict):
        raise ReceiptError(f"{label} must be a JSON object: {path}")
    return document


def command_candidate(arguments: argparse.Namespace) -> int:
    print(candidate_id(repository_root(arguments.root.resolve())))
    return 0


def command_fingerprint(arguments: argparse.Namespace) -> int:
    root = repository_root(arguments.root.resolve())
    fingerprint, _ = environment_fingerprint(root)
    print(fingerprint)
    return 0


def command_begin(arguments: argparse.Namespace) -> int:
    root = repository_root(arguments.root.resolve())
    gate = GATES[arguments.gate]
    validate_digest(arguments.candidate, "candidate id")
    host = gate_host(gate.name, arguments.candidate)
    fingerprint, descriptor = environment_fingerprint(root, gate.name, host)
    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%S.%fZ")
    stem = f"{stamp}-{os.getpid()}-{secrets.token_hex(4)}"
    log = state_root(root, gate.name) / "logs" / f"{stem}.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("x", encoding="utf-8"):
        pass
    atomic_json(
        run_metadata_path(log),
        {
            "schema": gate.run_schema,
            "status": "running",
            "candidate_before": arguments.candidate,
            "environment": descriptor,
            "environment_fingerprint": fingerprint,
            "host_sha256": host,
            "log": relative_to_root(log, root),
            "started_at": utc_now(),
        },
    )
    print(log)
    return 0


def command_complete(arguments: argparse.Namespace) -> int:
    root = repository_root(arguments.root.resolve())
    gate = GATES[arguments.gate]
    log = safe_log_path(root, arguments.log, gate.name)
    metadata_path = run_metadata_path(log)
    document = load_json(metadata_path, "run metadata")
    if document.get("schema") != gate.run_schema or document.get("status") != "running":
        raise ReceiptError(
            f"run metadata is not an active {gate.run_schema} record: {metadata_path}"
        )
    if document.get("candidate_before") != arguments.candidate_before:
        raise ReceiptError("candidate-before does not match the run metadata")
    validate_digest(arguments.candidate_before, "candidate-before")
    if arguments.candidate_after != "ERROR":
        validate_digest(arguments.candidate_after, "candidate-after")
    if not log.is_file():
        raise ReceiptError(f"run log is missing: {log}")

    if arguments.outcome == "passed":
        if arguments.exit_code != 0:
            raise ReceiptError("a passed run must have exit code 0")
        if arguments.candidate_after != arguments.candidate_before:
            raise ReceiptError("a passed run must preserve candidate identity")
        drift = None
        current_host = gate_host(gate.name, arguments.candidate_before)
        if current_host != document.get("host_sha256"):
            drift = "host identity changed during the gate"
        else:
            current_fingerprint, _ = environment_fingerprint(root, gate.name, current_host)
            if current_fingerprint != document.get("environment_fingerprint"):
                drift = "environment fingerprint changed during the gate"
        if drift is not None:
            # Record the attempt as terminal and non-passing before refusing,
            # so release verification counts and names it.
            finish_run(log, metadata_path, document, gate, arguments, "environment-drift", 1, drift)
            raise ReceiptError(f"gate={gate.name} candidate={arguments.candidate_before}: {drift}")
        relative_log = relative_to_root(log, root)
        terminal_lines = (
            f"CHECK RECEIPT STORED gate={gate.name} candidate={arguments.candidate_before}"
            f" log={relative_log}\n"
            f"{gate.pass_line}\n"
        )
        with log.open("a", encoding="utf-8") as handle:
            handle.write(terminal_lines)
            handle.flush()
            os.fsync(handle.fileno())
        log_digest = sha256_file(log)
        completed_at = utc_now()
        receipt = {
            "schema": gate.schema,
            "candidate_id": arguments.candidate_before,
            "command": gate.command,
            "completed_at": completed_at,
            "environment": document["environment"],
            "environment_fingerprint": document["environment_fingerprint"],
            "log": relative_log,
            "log_sha256": log_digest,
            "run": relative_to_root(metadata_path, root),
        }
        atomic_json(
            receipt_path(
                root, arguments.candidate_before, document["environment_fingerprint"], gate.name
            ),
            receipt,
        )
        document.update(
            {
                "candidate_after": arguments.candidate_after,
                "completed_at": completed_at,
                "exit_code": 0,
                "log_sha256": log_digest,
                "status": "passed",
            }
        )
        atomic_json(metadata_path, document)
        print(terminal_lines, end="")
        return 0

    if arguments.exit_code == 0:
        raise ReceiptError("a non-passed run must have a non-zero exit code")
    if arguments.outcome == "candidate-drift" and arguments.candidate_after in (
        "ERROR",
        arguments.candidate_before,
    ):
        raise ReceiptError("candidate-drift requires two different candidate ids")
    if arguments.outcome == "identity-error" and arguments.candidate_after != "ERROR":
        raise ReceiptError("identity-error requires candidate-after=ERROR")

    finish_run(
        log, metadata_path, document, gate, arguments, arguments.outcome, arguments.exit_code
    )
    return 0


def finish_run(
    log: Path,
    metadata_path: Path,
    document: dict[str, Any],
    gate: Gate,
    arguments: argparse.Namespace,
    status: str,
    exit_code: int,
    reason: str | None = None,
) -> None:
    """Make a run record terminal and non-passing; it is never deleted."""
    root = repository_root(arguments.root.resolve())
    relative_log = relative_to_root(log, root)
    suffix = f" reason={reason}" if reason else ""
    terminal_line = (
        f"CHECK RECEIPT RUN {status.upper()} gate={gate.name} "
        f"candidate={arguments.candidate_before} exit={exit_code} log={relative_log}{suffix}\n"
    )
    with log.open("a", encoding="utf-8") as handle:
        handle.write(terminal_line)
        handle.flush()
        os.fsync(handle.fileno())
    document.update(
        {
            "candidate_after": arguments.candidate_after,
            "completed_at": utc_now(),
            "exit_code": exit_code,
            "log_sha256": sha256_file(log),
            "status": status,
        }
    )
    atomic_json(metadata_path, document)
    print(terminal_line.rstrip(), file=sys.stderr)


def miss(reason: str) -> int:
    print(f"CHECK RECEIPT MISS reason={reason}; running ./bin/check all", file=sys.stderr)
    return 1


def parse_push_input(raw: str) -> list[str] | None:
    local_shas: list[str] = []
    for line in raw.splitlines():
        fields = line.split()
        if len(fields) != 4:
            return None
        local_sha = fields[1]
        if len(local_sha) not in (40, 64) or any(
            character not in "0123456789abcdef" for character in local_sha
        ):
            return None
        if any(character != "0" for character in local_sha):
            local_shas.append(local_sha)
    return local_shas


def validate_receipt(
    root: Path, gate_name: str, candidate: str, fingerprint: str, descriptor: dict[str, str]
) -> tuple[dict[str, Any] | None, dict[str, Any] | None, str | None]:
    """Validate the gate's receipt for this candidate and environment.

    Returns ``(receipt, run, None)`` for a trustworthy passing receipt, or
    ``(None, None, reason)`` naming the first failed check.
    """
    gate = GATES[gate_name]
    path = receipt_path(root, candidate, fingerprint, gate.name)
    if not path.is_file() or path.is_symlink():
        return None, None, "receipt-not-found"
    receipt = load_json(path, "receipt")
    if set(receipt) != RECEIPT_FIELDS:
        return None, None, "receipt-schema-mismatch"
    if (
        receipt.get("schema") != gate.schema
        or receipt.get("candidate_id") != candidate
        or receipt.get("command") != gate.command
        or receipt.get("environment") != descriptor
        or receipt.get("environment_fingerprint") != fingerprint
    ):
        return None, None, "receipt-identity-mismatch"
    log = safe_log_path(root, str(receipt.get("log", "")), gate.name)
    if not log.is_file() or sha256_file(log) != receipt.get("log_sha256"):
        return None, None, "receipt-log-mismatch"
    run_path = Path(str(receipt.get("run", "")))
    if not run_path.is_absolute():
        run_path = root / run_path
    runs_root = (state_root(root, gate.name) / "logs").resolve()
    if not run_path.resolve().is_relative_to(runs_root):
        return None, None, "receipt-run-path-invalid"
    run = load_json(run_path, "run metadata")
    if (
        set(run) != RUN_FIELDS
        or run.get("schema") != gate.run_schema
        or run.get("status") != "passed"
        or run.get("candidate_before") != candidate
        or run.get("candidate_after") != candidate
        or run.get("environment") != descriptor
        or run.get("environment_fingerprint") != fingerprint
        or run.get("log") != receipt.get("log")
        or run.get("log_sha256") != receipt.get("log_sha256")
        or run.get("completed_at") != receipt.get("completed_at")
        or run.get("exit_code") != 0
    ):
        return None, None, "receipt-run-mismatch"
    return receipt, run, None


def command_pre_push(arguments: argparse.Namespace) -> int:
    try:
        root = repository_root(arguments.root.resolve())
        local_shas = parse_push_input(sys.stdin.read())
        if local_shas is None:
            return miss("invalid-push-input")
        if not local_shas:
            return miss("no-nondeleted-ref")
        head = run_command(root, "git", "rev-parse", "HEAD")
        if any(local_sha != head for local_sha in local_shas):
            return miss("pushed-ref-is-not-head")
        if run_command(root, "git", "status", "--porcelain=v1", "--untracked-files=all"):
            return miss("working-tree-not-clean")
        candidate = candidate_id(root)
        fingerprint, descriptor = environment_fingerprint(root)
        receipt, _, reason = validate_receipt(root, "all", candidate, fingerprint, descriptor)
        if receipt is None:
            return miss(reason or "receipt-not-found")
        print(f"CHECK RECEIPT HIT candidate={candidate} log={receipt['log']}")
        return 0
    except (OSError, ReceiptError) as exc:
        print(f"CHECK RECEIPT ERROR {exc}", file=sys.stderr)
        return miss("receipt-query-error")


def native_attempts(root: Path, candidate: str, host: str) -> list[dict[str, Any]]:
    """Every native run record for this candidate and host, oldest first.

    A record still marked ``running`` is an interrupted or in-flight attempt,
    not a pass, and is included. An unreadable record refuses: an attempt
    must never vanish from the verdict.
    """
    gate = GATES["native"]
    logs = state_root(root, gate.name) / "logs"
    rows: list[dict[str, Any]] = []
    if not logs.is_dir():
        return rows
    for metadata in sorted(logs.glob("*.json")):
        run = load_json(metadata, "gate=native run metadata")
        if (
            run.get("schema") != gate.run_schema
            or run.get("candidate_before") != candidate
            or run.get("host_sha256") != host
        ):
            continue
        rows.append({**run, "_path": relative_to_root(metadata, root)})
    rows.sort(key=lambda row: (attempt_time(row), row["_path"]))
    return rows


def attempt_time(run: dict[str, Any]) -> datetime:
    """Order by completion, or by start for an attempt that never finished."""
    raw = str(run.get("completed_at") or run.get("started_at") or "")
    try:
        return datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ReceiptError(f"gate=native run {run.get('log')} has no valid time: {raw!r}") from exc


def missing_receipt_reason(root: Path, gate_name: str, candidate: str, host: str) -> str:
    """Name why no receipt matches: another host, another candidate, or none at all."""
    receipts = state_root(root, gate_name) / "receipts"
    paths = sorted(receipts.glob("*.json")) if receipts.is_dir() else []
    for path in paths:
        receipt = load_json(path, f"gate={gate_name} receipt")
        if receipt.get("candidate_id") != candidate:
            continue
        if gate_name == "native":
            recorded = receipt.get("environment", {}).get("host_sha256")
        else:
            recorded = load_json(root / str(receipt.get("run", "")), "run metadata").get(
                "host_sha256"
            )
        if recorded != host:
            return "host-mismatch"
    return "receipt-identity-mismatch" if paths else "receipt-not-found"


def release_refusal(gate: str, reason: str, candidate: str, detail: str = "") -> int:
    suffix = f" {detail}" if detail else ""
    print(
        f"CHECK RELEASE REFUSED gate={gate} reason={reason} candidate={candidate}{suffix}",
        file=sys.stderr,
    )
    return 1


def command_release_verify(arguments: argparse.Namespace) -> int:
    """Verify passing ``all`` and ``native`` receipts for the clean current candidate.

    The newest native attempt for the candidate and this host must be the
    receipt's passing run; a newer failed, interrupted or in-flight attempt
    refuses. Earlier non-passing attempts stay on record and are named;
    nothing is cured, retried or deleted here.
    """
    root = repository_root(arguments.root.resolve())
    candidate = candidate_id(root)
    if run_command(root, "git", "status", "--porcelain=v1", "--untracked-files=all"):
        return release_refusal("release", "working-tree-not-clean", candidate)
    try:
        host = host_sha256()
    except HostIdentityError as exc:
        return release_refusal("release", "host-identity-unavailable", candidate, f"error={exc}")
    if host is None:
        return release_refusal("release", "host-identity-unavailable", candidate)
    try:
        return verify_release(root, candidate, host)
    except (OSError, ReceiptError) as exc:
        return release_refusal("release", "run-record-unreadable", candidate, f"error={exc}")


def verify_release(root: Path, candidate: str, host: str) -> int:
    attempts = native_attempts(root, candidate, host)
    nonpassing = [row for row in attempts if row.get("status") != "passed"]
    latest = f" latest-failed-run={nonpassing[-1]['_path']}" if nonpassing else ""
    detail = f"native-failed-runs={len(nonpassing)}{latest}" if nonpassing else ""
    verified: dict[str, dict[str, Any]] = {}
    for gate_name in ("all", "native"):
        fingerprint, descriptor = environment_fingerprint(root, gate_name, host)
        gate_detail = detail if gate_name == "native" else ""
        receipt, run, reason = validate_receipt(root, gate_name, candidate, fingerprint, descriptor)
        if receipt is None or run is None:
            if reason == "receipt-not-found":
                reason = missing_receipt_reason(root, gate_name, candidate, host)
            return release_refusal(gate_name, reason or "receipt-not-found", candidate, gate_detail)
        if run.get("host_sha256") != host:
            return release_refusal(gate_name, "host-mismatch", candidate, gate_detail)
        verified[gate_name] = receipt
    newest = attempts[-1] if attempts else None
    if newest is None or newest.get("log") != verified["native"]["log"]:
        reason = (
            "native-run-unfinished"
            if newest is not None and newest.get("status") == "running"
            else "native-failure-after-pass"
        )
        return release_refusal("native", reason, candidate, detail)
    for row in nonpassing:
        print(
            f"CHECK RELEASE NOTE earlier-failed-native-run={row['_path']}"
            f" status={row.get('status')} completed_at={row.get('completed_at')}"
        )
    print(
        f"CHECK RELEASE VERIFIED candidate={candidate} all={verified['all']['log']}"
        f" native={verified['native']['log']} native-failed-runs={len(nonpassing)}{latest}"
    )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name, function in (
        ("candidate", command_candidate),
        ("fingerprint", command_fingerprint),
    ):
        command = subparsers.add_parser(name)
        command.add_argument("--root", type=Path, default=Path.cwd())
        command.set_defaults(function=function)

    begin = subparsers.add_parser("begin")
    begin.add_argument("--root", type=Path, default=Path.cwd())
    begin.add_argument("--gate", choices=sorted(GATES), default="all")
    begin.add_argument("--candidate", required=True)
    begin.set_defaults(function=command_begin)

    complete = subparsers.add_parser("complete")
    complete.add_argument("--root", type=Path, default=Path.cwd())
    complete.add_argument("--gate", choices=sorted(GATES), default="all")
    complete.add_argument("--log", required=True)
    complete.add_argument("--candidate-before", required=True)
    complete.add_argument("--candidate-after", required=True)
    complete.add_argument("--exit-code", required=True, type=int)
    complete.add_argument(
        "--outcome",
        required=True,
        choices=("passed", "failed", "candidate-drift", "identity-error", "log-failed"),
    )
    complete.set_defaults(function=command_complete)

    pre_push = subparsers.add_parser("pre-push")
    pre_push.add_argument("--root", type=Path, default=Path.cwd())
    pre_push.set_defaults(function=command_pre_push)

    release_verify = subparsers.add_parser("release-verify")
    release_verify.add_argument("--root", type=Path, default=Path.cwd())
    release_verify.set_defaults(function=command_release_verify)
    return parser


def main() -> int:
    arguments = build_parser().parse_args()
    try:
        return int(arguments.function(arguments))
    except (OSError, ReceiptError) as exc:
        print(f"check-receipt: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
